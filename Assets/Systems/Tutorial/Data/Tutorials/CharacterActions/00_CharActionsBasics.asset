  m_Script: {fileID: 11500000, guid: 982535986ffddd54693d6376c3f54039, type: 3}
  m_Name: 00_CharActionsBasics
  m_EditorClassIdentifier: 
  tutorialId: 0
  titleText: Basic Controls
  actions:
  - ActionType: 1
    AnimationDirection: 1
    MessageText: 'Hello stranger!  You are a squirell and this is your playground...
      or forest prison.  '
    MessageDisplayTime: 2
  - ActionType: 1
    AnimationDirection: 1
    MessageText: To survive you have collect nuts and get them to your nests!  If
      you get nuts to all your nests, you win!
    MessageDisplayTime: 2
  - ActionType: 1
    AnimationDirection: 1
    MessageText: But you will not enjoy your deserved retirement. Instead you will
      be teleported to new prison and start over! Well, life is not fair!
    MessageDisplayTime: 3
  - ActionType: 1
    AnimationDirection: 1
    MessageText: But first, let me explain how to control this tiny nutty beast!
      Mostly you will use arrows. You can use your keyboard or click buttons on the
      screen. Lets try to press button up!
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 0
  - ActionType: 1
    AnimationDirection: 1
    MessageText: Did you see? If you press arrow in new direction once, the squirell
      just turns in that direction. Lets try again to the left!
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 3
    MessageText: 
    MessageDisplayTime: 0
  - ActionType: 1
    AnimationDirection: 1
    MessageText: And now you turned to left! Lets see what happens if you press left
      button one more time!
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 3
    MessageText: 
    MessageDisplayTime: 0
  - ActionType: 1
    AnimationDirection: 1
    MessageText: What?! No turning now? You moved! That is so confusing! Well, get
      used to it! If you press arrow matching your direction, you move!
    MessageDisplayTime: 2
  - ActionType: 1
    AnimationDirection: 1
    MessageText: Lets do it again, this time to the right!
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 0
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 0
  - ActionType: 1
    AnimationDirection: 1
    MessageText: Did you get it?! So, let's continue. How to move nuts? You need
      to push them by moving squirell on nuts position. Let me show you
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 2
    MessageText: 
    MessageDisplayTime: 0
  - ActionType: 0
    AnimationDirection: 2
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 1
    AnimationDirection: 1
    MessageText: 'See? This is how you push Nuts. You can push nuts only in direction
      of squirell movement. '
    MessageDisplayTime: 3
  - ActionType: 1
    AnimationDirection: 1
    MessageText: To finish level, you need to get the nut into squirells nest. Let's
      try to do it!
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: we are finished here
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 1
    AnimationDirection: 1
    MessageText: You can move freely on squirells nest!
    MessageDisplayTime: 2
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 3
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 3
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 3
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 2
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 2
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 0
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 1
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 2
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 0
    AnimationDirection: 2
    MessageText: 
    MessageDisplayTime: 3
  - ActionType: 1
    AnimationDirection: 2
    MessageText: 'Congrats for hard work! You got your first nut home! '
    MessageDisplayTime: 3
