  titleText: Undo
  actions:
  - ActionType: 1
    MovementSteps: []
    MessageSteps:
    - MessageText: 'Hello again! This game can be full of trials and errors. One
        small mistake and your hard effort goes to nut. '
      DisplayTime: 4
    UndoCount: 0
    ImageAction:
      Image: {fileID: 0}
      ActionType: 0
      ImageRotation: 0
      DisplayTime: 0
  - ActionType: 3
    MovementSteps: []
    MessageSteps:
    - MessageText: 'Hello again! This game can be full of trials and errors. One
        small mistake and you can start over from beginning. '
      DisplayTime: 3
    UndoCount: 0
    ImageAction:
      Image: {fileID: 838888815, guid: 34762e688194226468cb33c740b1f051, type: 3}
      ActionType: 0
      ImageRotation: 0
      DisplayTime: 0
  - ActionType: 1
    MovementSteps: []
    MessageSteps:
    - MessageText: Of course you can always restart the level and start over.
      DisplayTime: 4
    - MessageText: 'But still, make a wrong move right before the end and not cracking
        the nut might get you nuts! '
      DisplayTime: 5
    - MessageText: For that case you can use "Undo"!
      DisplayTime: 3
    UndoCount: 0
    ImageAction:
      Image: {fileID: 838888815, guid: 34762e688194226468cb33c740b1f051, type: 3}
      ActionType: 0
      ImageRotation: 0
      DisplayTime: 0
